{
  "name": "mcp-servers",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run tests/unit tests/contract tests/integration",
    "test:unit": "vitest run tests/unit",
    "test:contract": "vitest run tests/contract",
    "test:integration": "vitest run tests/integration",
    "test:smoke": "tsx tests/smoke/http.ts",
    "test:conformance": "tsx tests/conformance/run-core.ts",
    "check": "pnpm build && pnpm test:unit && pnpm test:contract && pnpm test:integration && pnpm test:smoke",
    "dev": "pnpm build && pnpm --filter @mcp-platform/host dev",
    "auth:key": "pnpm build && node apps/host/dist/auth-cli.js"
  },
  "devDependencies": {
    "@mcp-platform/host": "workspace:*",
    "@mcp-platform/mcp-kit": "workspace:*",
    "@mcp-platform/runtime": "workspace:*",
    "@mcp-platform/testing": "workspace:*",
    "@mcp-server/example": "workspace:*",
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "24.12.4",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "zod": "^4.1.0"
  }
}
