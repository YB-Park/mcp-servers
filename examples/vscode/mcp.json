{
  "inputs": [
    {
      "type": "promptString",
      "id": "company-mcp-key",
      "description": "Company MCP API key",
      "password": true
    }
  ],
  "servers": {
    "company-example": {
      "type": "http",
      "url": "http://mcp-server.company.local:3000/mcp/example",
      "headers": {
        "Authorization": "Bearer ${input:company-mcp-key}"
      }
    }
  }
}
