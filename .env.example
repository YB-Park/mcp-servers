MCP_HOST=127.0.0.1
MCP_PORT=3000
# Required when MCP_HOST is a non-loopback interface such as 0.0.0.0.
# Comma-separated hostnames, without ports.
# MCP_ALLOWED_HOSTS=mcp.internal.example
# Optional browser Origin allowlist. Non-browser MCP clients usually omit Origin.
# MCP_ALLOWED_ORIGINS=vscode-web.internal.example
