MCP_HOST=127.0.0.1
MCP_PORT=3000

# Required when MCP_HOST is a non-loopback interface such as 0.0.0.0.
# Comma-separated hostnames, without ports.
# MCP_ALLOWED_HOSTS=mcp.internal.example

# Optional browser Origin hostname allowlist, without scheme or port.
# Non-browser MCP clients usually omit Origin. On non-loopback bindings, any
# request that does send Origin is rejected unless its hostname is listed here.
# MCP_ALLOWED_ORIGINS=vscode-web.internal.example

# Authentication mode: localhost defaults to none; non-loopback defaults to api-key.
# MCP_AUTH_MODE=api-key

# Managed API-key database. The file contains hashes/metadata, never plaintext keys.
# Keep it outside source control and persist/back it up according to your operations policy.
MCP_AUTH_STORE=.data/auth-keys.json

# Dangerous diagnostics-only escape hatch. A non-loopback host refuses no-auth mode
# unless this is explicitly true. Do not enable it on a shared/internal production host.
MCP_ALLOW_INSECURE_NO_AUTH=false
